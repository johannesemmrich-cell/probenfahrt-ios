# Xcode project is generated by XcodeGen from project.yml - not checked in
*.xcodeproj/
*.xcworkspace/

xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
*.xcuserstate
.build/
.swiftpm/

# macOS
.DS_Store

# CloudKit Server-to-Server private key + server-only config — never commit
# (see web/README setup steps)
web/eckey.pem
web/eckey_pkcs8.pem
web/server_config.py
__pycache__/

# Cloudflare Worker deploy artifacts
web/worker/.wrangler/
web/worker/node_modules/
web/worker-app/.wrangler/
web/worker-app/node_modules/

# Lokale Secrets für `wrangler dev` (Pendant zu server_config.py) — nie
# committen, echte Werte kommen für den Live-Deploy per `wrangler secret put`
web/worker/.dev.vars
web/worker-app/.dev.vars
